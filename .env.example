# Meta Model API (https://dev.meta.ai) — every model call (Muse Spark, Muse Wonder, SAM 3.1, Muse Voice Transcribe, web search)
MODEL_API_KEY=
# Optional: move one role to another OpenAI-compatible provider (e.g. Muse Spark Open on Fireworks/Baseten/Modal)
# MODEL_<ROLE>_BASE_URL=   MODEL_<ROLE>_MODEL=   MODEL_<ROLE>_KEY_ENV=   MODEL_<ROLE>_EFFORT=
# Speech output
ELEVENLABS_API_KEY=
# Session signing
SESSION_SECRET=
# Sign-in emails go through the Cloudflare Email binding (EMAIL); optional sender override
EMAIL_FROM=
# Gmail (read-only) and calendar connections via Composio
COMPOSIO_API_KEY=
COMPOSIO_PROJECT_ID=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
COMPOSIO_MICROSOFTCALENDAR_AUTH_CONFIG_ID=
# Outbound calls (demo accounts listed in DEMO_CALL_EMAILS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEMO_CALL_NUMBER=
