{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "name": "dossierly-meta",
  "triggers": {
    "crons": [
      "*/2 * * * *",
      "0 2 * * *"
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dossierly.cosmiclan.com",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dossierly-meta"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dossierly-meta-db",
      "database_id": "71b60363-0402-4d8d-8a7f-afc976cc6ebc",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "036b53cfc0b94280a0858d89d1fd7dab"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "dossierly-meta-blobs",
      "jurisdiction": "eu"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDO"
      },
      {
        "name": "CASE_DO",
        "class_name": "CaseDO"
      },
      {
        "name": "VOICE_DO",
        "class_name": "VoiceDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "UserDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "CaseDO"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "VoiceDO"
      ]
    }
  ],
  "workflows": [
    {
      "name": "dossierly-meta-prepare-fallback",
      "binding": "PREPARE_FALLBACK",
      "class_name": "PrepareFallback"
    },
    {
      "name": "dossierly-meta-letter-pipeline",
      "binding": "LETTER_PIPELINE",
      "class_name": "LetterPipeline"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "no-reply@dossierly.cosmiclan.com",
        "wsc-przyklad@dossierly.cosmiclan.com"
      ]
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://dossierly.cosmiclan.com",
    "DEMO_CALL_EMAILS": "darthstormer.ai@gmail.com,gabrielantony56@gmail.com"
  },
  "env": {
